# Firefly Docker defaults
FIREFLY_HOST=0.0.0.0
FIREFLY_PORT=5011
# Ignored when docker-compose.yml uses host networking.
FIREFLY_WEB_PORT=5011
FIREFLY_DATABASE_FILE=/app/data/mudpchat.db
FIREFLY_UDP_PORT=4403
# Meshtastic 2.8+; use 224.0.0.69 for older firmware.
FIREFLY_MCAST_GRP=239.0.0.69
# Optional; a persistent random session secret is generated if empty.
FIREFLY_SECRET_KEY=
FIREFLY_DEBUG=false

# Development only: opt into sibling dependency checkouts.
# FIREFLY_LOCAL_DEPS=1
